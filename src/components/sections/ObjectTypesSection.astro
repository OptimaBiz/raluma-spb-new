---
const objects = [
  {
    href: '/terraces/',
    label: 'Терраса',
    title: 'Остекление готовой террасы',
    text: 'Защита от ветра и осадков с возможностью снова полностью открыть пространство.',
    image: '/images/gallery/terrasy/slide-terrasy-2.webp',
    alt: 'Безрамное остекление готовой террасы',
  },
  {
    href: '/verandas/',
    label: 'Веранда',
    title: 'Панорамное остекление веранды',
    text: 'Подбор системы под архитектуру дома, ширину проёмов и сценарий открывания.',
    image: '/images/gallery/verandy/slide-verandy-10.webp',
    alt: 'Панорамное остекление готовой веранды',
  },
  {
    href: '/gazebos/',
    label: 'Беседка',
    title: 'Остекление беседки и зоны отдыха',
    text: 'Больше комфорта в непогоду без потери света и открытого вида на участок.',
    image: '/images/cases/wooden-gazebo/main-1.webp',
    alt: 'Безрамное остекление деревянной беседки',
  },
];
---

<section class="object-types seams" id="objects" aria-labelledby="object-types-title">
  <div class="shell">
    <header class="object-types__head rise">
      <div>
        <p class="eyebrow eyebrow--edge">Выберите ваш объект</p>
        <h2 class="title" id="object-types-title">Что нужно остеклить?</h2>
      </div>
      <p class="lead">
        Посмотрите решение, реальные ориентиры стоимости и требования к готовому проёму для вашего типа объекта.
      </p>
    </header>

    <div class="object-types__grid">
      {objects.map((item, index) => (
        <a
          class="object-types__card rise"
          href={item.href}
          aria-label={`${item.title}: открыть подробную страницу`}
        >
          <div class="object-types__media">
            <img src={item.image} alt={item.alt} width="900" height="720" loading="lazy" decoding="async" />
          </div>
          <div class="object-types__body">
            <p class="object-types__label figure">0{index + 1} · {item.label}</p>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <span>Подробнее об остеклении <b aria-hidden="true">→</b></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .object-types {
    padding-block: var(--section-y);
    background: var(--c-light-raised);
  }

  .object-types__head {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(300px, 0.7fr);
    gap: clamp(32px, 7vw, 112px);
    align-items: end;
    margin-bottom: clamp(36px, 5vw, 68px);
  }

  .object-types__head > div {
    display: grid;
    gap: 18px;
  }

  .object-types__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--c-seam);
    border-left: 1px solid var(--c-seam);
  }

  .object-types__card {
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 0;
    color: inherit;
    text-decoration: none;
    border-right: 1px solid var(--c-seam);
    border-bottom: 1px solid var(--c-seam);
    background: var(--c-light);
    transition: background-color var(--dur-fast) ease;
  }

  .object-types__card:hover {
    background: #fff;
  }

  .object-types__media {
    aspect-ratio: 1.2;
    overflow: hidden;
    background: #d7dcda;
  }

  .object-types__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-base) var(--ease-open);
  }

  .object-types__card:hover .object-types__media img {
    transform: scale(1.025);
  }

  .object-types__body {
    display: grid;
    align-content: start;
    padding: clamp(24px, 3vw, 38px);
  }

  .object-types__label {
    margin: 0 0 18px;
    font-size: var(--t-micro);
    color: var(--c-edge);
  }

  .object-types__body h3 {
    margin: 0;
    font-family: var(--f-display);
    font-size: clamp(22px, 2.2vw, 31px);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .object-types__body > p:not(.object-types__label) {
    margin: 18px 0 0;
    line-height: 1.65;
    color: var(--c-ink-soft);
  }

  .object-types__body span {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 30px;
    padding-top: 18px;
    border-top: 1px solid var(--c-seam);
    font-size: var(--t-small);
    font-weight: 500;
  }

  .object-types__body b {
    color: var(--c-edge);
    font-weight: 400;
  }

  @media (max-width: 900px) {
    .object-types__head {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .object-types__grid {
      grid-template-columns: 1fr;
    }

    .object-types__card {
      grid-template-columns: minmax(180px, 0.8fr) minmax(0, 1.2fr);
      grid-template-rows: none;
    }

    .object-types__media {
      aspect-ratio: auto;
      min-height: 280px;
    }
  }

  @media (max-width: 620px) {
    .object-types {
      padding-block: 76px;
    }

    .object-types__card {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }

    .object-types__media {
      aspect-ratio: 1.35;
      min-height: 0;
    }

    .object-types__body {
      padding: 24px 20px 26px;
    }
  }
</style>
